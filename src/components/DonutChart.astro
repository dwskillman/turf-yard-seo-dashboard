---
/**
 * DonutChart.astro — Chart.js doughnut chart island.
 */
interface Props {
  id: string;
  labels: string[];
  data: number[];
  colors: string[];
  height?: number;
}
const { id, labels, data, colors, height = 240 } = Astro.props;
const payload = JSON.stringify({ labels, data, colors });
---

<div class="relative w-full" style={`height:${height}px`}>
  <canvas id={id} data-donut={payload}></canvas>
</div>

<script>
  import Chart from 'chart.js/auto';

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-donut]').forEach((canvas) => {
    if (canvas.dataset.rendered) return;
    canvas.dataset.rendered = '1';
    const cfg = JSON.parse(canvas.dataset.donut!);
    const ctx = canvas.getContext('2d')!;

    new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels: cfg.labels,
        datasets: [
          {
            data: cfg.data,
            backgroundColor: cfg.colors,
            borderColor: '#FFFFFF',
            borderWidth: 2,
            hoverOffset: 6,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '62%',
        plugins: {
          legend: {
            position: 'right',
            labels: {
              boxWidth: 12,
              boxHeight: 12,
              color: '#5F6B5F',
              font: { size: 11 },
              usePointStyle: true,
              padding: 12,
            },
          },
          tooltip: {
            backgroundColor: '#1E2A1F',
            titleColor: '#FBFAF5',
            bodyColor: '#D8E6CF',
            padding: 10,
            cornerRadius: 8,
          },
        },
      },
    });
  });
</script>

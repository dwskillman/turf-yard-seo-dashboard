---
/**
 * Sparkline.astro — tiny inline SVG sparkline (no Chart.js needed).
 */
interface Props {
  data: number[];
  color?: string;
  invert?: boolean; // when true, a downward trend is "good" (green)
  width?: number;
  height?: number;
}
const { data, color, invert = false, width = 120, height = 32 } = Astro.props;

let path = '';
let strokeColor = color ?? '#6FA86B';

if (data.length >= 2) {
  const min = Math.min(...data);
  const max = Math.max(...data);
  const range = max - min || 1;
  const stepX = width / (data.length - 1);
  path = data
    .map((v, i) => {
      const x = i * stepX;
      const y = height - ((v - min) / range) * (height - 4) - 2;
      return `${i === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');

  if (!color) {
    // Determine trend direction across the series.
    const rising = data[data.length - 1] >= data[0];
    const good = invert ? !rising : rising;
    strokeColor = good ? '#2F6B3A' : '#A84B2F';
  }
}
---

{data.length >= 2 ? (
  <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} fill="none" aria-hidden="true">
    <path d={path} stroke={strokeColor} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
) : (
  <span class="text-xs text-ink-faint">—</span>
)}

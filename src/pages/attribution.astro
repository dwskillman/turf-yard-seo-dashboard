---
/**
 * attribution.astro — Conversion Attribution page.
 * Shows which sources drive each key conversion event,
 * using horizontal bar charts per event and a master table.
 */
import Layout from '../components/Layout.astro';
import Section from '../components/Section.astro';
import BarChart from '../components/BarChart.astro';
import DataTable from '../components/DataTable.astro';
import { getConversionAttribution, latestWeek } from '../lib/db';
import { num } from '../lib/formatters';

const attribution = getConversionAttribution();
const latestWk = latestWeek('conversion_attribution_weekly');

// Key conversion events to feature
const KEY_EVENTS = [
  'form_submit',
  'phone_click',
  'quote_request_click',
  'generate_lead',
  'calculator_complete',
  'calculator_start',
  'form_start',
  'file_download',
];

// Bucket color mapping
const BUCKET_COLORS: Record<string, string> = {
  search:   '#2F6B3A',
  direct:   '#6FA86B',
  ai:       '#C9A271',
  reddit:   '#A84B2F',
  social:   '#D19900',
  referral: '#8E978D',
  other:    '#D8E6CF',
};

// Group attribution rows by event name
const byEvent = new Map<string, typeof attribution>();
for (const row of attribution) {
  if (!byEvent.has(row.event_name)) byEvent.set(row.event_name, []);
  byEvent.get(row.event_name)!.push(row);
}

// Build per-event chart configs (only events present in data or in KEY_EVENTS)
const eventCharts = KEY_EVENTS
  .map((eventName) => {
    const rows = byEvent.get(eventName) ?? [];
    if (rows.length === 0) return null;
    const sorted = [...rows].sort((a, b) => (b.event_count ?? 0) - (a.event_count ?? 0));
    const labels = sorted.map((r) => r.source);
    const data = sorted.map((r) => r.event_count ?? 0);
    const colors = sorted.map((r) => BUCKET_COLORS[r.bucket] ?? '#D8E6CF');
    const total = data.reduce((s, v) => s + v, 0);
    return { eventName, labels, data, colors, total };
  })
  .filter(Boolean) as { eventName: string; labels: string[]; data: number[]; colors: string[]; total: number }[];

// Master table: all attribution rows
const tableRows = [...attribution]
  .sort((a, b) => (b.event_count ?? 0) - (a.event_count ?? 0))
  .map((row) => [
    { html: `<span class="font-mono text-xs text-ink">${row.event_name}</span>`, sort: row.event_name },
    { html: `<span class="font-medium">${row.source}</span>`, sort: row.source },
    {
      html: `<span class="inline-flex items-center text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:${BUCKET_COLORS[row.bucket] ?? '#ccc'}22;color:${BUCKET_COLORS[row.bucket] ?? '#666'}">${row.bucket}</span>`,
      sort: row.bucket,
    },
    { html: `<span class="tabular-nums font-medium">${num(row.event_count)}</span>`, sort: row.event_count ?? 0 },
    { html: `<span class="tabular-nums text-ink-muted">${num(row.total_users)}</span>`, sort: row.total_users ?? 0 },
  ]);
---

<Layout title="Attribution" active="attribution">
  <Section
    eyebrow="Conversion Attribution"
    title="Which channels drive conversions?"
    subtitle={latestWk ? `Week of ${latestWk} · source × conversion event matrix` : 'Baseline 28-day window'}
  />

  {attribution.length === 0 ? (
    <div class="card p-8 text-center text-ink-faint mb-8">
      <p class="text-sm">No attribution data available. Run <code class="font-mono text-xs">npm run setup</code> to populate.</p>
    </div>
  ) : (
    <>
      <!-- Per-event horizontal bar charts -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-8">
        {eventCharts.map(({ eventName, labels, data, colors, total }) => (
          <div class="card p-5">
            <div class="flex items-start justify-between mb-3">
              <div>
                <p class="font-mono text-sm font-semibold text-ink">{eventName}</p>
                <p class="text-xs text-ink-faint">{total.toLocaleString()} total conversions</p>
              </div>
            </div>
            <!-- Custom horizontal bar viz (inline, no Chart.js for compact cards) -->
            <div class="space-y-2">
              {labels.map((label, i) => {
                const maxVal = Math.max(...data, 1);
                const pct = (data[i] / maxVal) * 100;
                return (
                  <div>
                    <div class="flex items-center justify-between text-xs mb-0.5">
                      <span class="text-ink-muted truncate max-w-[140px]">{label}</span>
                      <span class="tabular-nums font-medium text-ink ml-2">{data[i]}</span>
                    </div>
                    <div class="h-2 w-full rounded-full bg-brand-green-soft/60 overflow-hidden">
                      <div
                        class="h-2 rounded-full transition-all"
                        style={`width:${pct}%;background:${colors[i]}`}
                      />
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- Bucket color legend -->
      <div class="flex flex-wrap gap-3 mb-6">
        {Object.entries(BUCKET_COLORS).map(([bucket, color]) => (
          <div class="flex items-center gap-1.5">
            <span class="inline-block w-3 h-3 rounded-sm" style={`background:${color}`} />
            <span class="text-xs text-ink-muted capitalize">{bucket}</span>
          </div>
        ))}
      </div>

      <!-- Master table -->
      <div class="mb-2">
        <Section eyebrow="Full Detail" title="Source × Event matrix" subtitle="All attribution rows sorted by event count. Click headers to re-sort." />
      </div>
      <DataTable
        id="attribution-table"
        initialSort={3}
        initialDir="desc"
        columns={[
          { key: 'event', label: 'Event', align: 'left', sortType: 'text' },
          { key: 'source', label: 'Source', align: 'left', sortType: 'text' },
          { key: 'bucket', label: 'Bucket', align: 'left', sortType: 'text' },
          { key: 'count', label: 'Count', align: 'right', sortType: 'number' },
          { key: 'users', label: 'Users', align: 'right', sortType: 'number' },
        ]}
        rows={tableRows}
      />
    </>
  )}
</Layout>
